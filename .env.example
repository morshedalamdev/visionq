# VisionQ foundation
# The "visionq info" command requires no environment variables.
# Copy privately and replace example credentials before starting services.
# PostgreSQL 16. Pinned to the multi-platform image index.
PG_IMAGE=pgvector/pgvector:pg16-bookworm@sha256:484e838076e04939d27d3e176e91c86eea96236126023be8d3059761122e579f
POSTGRES_PASSWORD=local-example-change-me
ARTIFACT_DIR=./artifacts/m1t2-live
# Base URL for the VLLM generation and embedding services.
# These services are used for text generation and embedding tasks.
VLLM_GENERATION_BASE_URL=http://vllm-gen:8000/v1
VLLM_EMBEDDING_BASE_URL=http://vllm-embed:8000/v1

# Read-only MCP service. Apply deploy/mcp-readonly-role.sql before starting it.
VISIONQ_MCP_DATABASE_URL=postgresql+psycopg://visionq_mcp:change-me@db/visionq
VISIONQ_MCP_TOKEN=local-example-mcp-token-change-before-use
VISIONQ_MCP_EMBEDDING_BACKEND=deterministic
VISIONQ_MCP_EMBEDDING_DIMENSIONS=8
# Optional private API retrieval. Empty disables document search.
VISIONQ_API_EMBEDDING_BACKEND=

# Local FastAPI and React dashboard.
VISIONQ_ANALYTICS_API_TOKEN=local-example-api-token-change-before-use
VITE_API_BASE_URL=/api
# Development-only local bearer token. Vite embeds VITE_ values in browser JS;
# never use this as a production secret or public authentication mechanism.
VITE_API_TOKEN=